{
  "name": "dsh-remielle-pet",
  "version": "1.1.1",
  "description": "dsh-remielle-pet（蕾米埃尔桌宠）：DSH 桌宠插件，在 DSH 界面显示跟随会话状态的宠物 GIF，支持 Web UI 与桌面版。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "default-gifs",
    "locale",
    "icon.png",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "Elysia (https://github.com/Shinarin)",
  "homepage": "https://github.com/Shinarin/dsh-remielle-pet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shinarin/dsh-remielle-pet.git"
  },
  "bugs": {
    "url": "https://github.com/Shinarin/dsh-remielle-pet/issues"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check client.js && node --check lib/index.js"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "cordis-plugin",
    "pet",
    "desk-pet",
    "desktop-pet",
    "remielle",
    "gif",
    "桌宠"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
